{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinky",
  "version": "0.1.0",
  "identifier": "dev.pinky.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Pinky", "width": 1440, "height": 900, "minWidth": 1040, "minHeight": 700, "resizable": true, "fullscreen": false },
      { "label": "ambient", "create": false, "url": "index.html?window=ambient", "title": "Ambient ALMA", "width": 480, "height": 480, "minWidth": 260, "minHeight": 260, "resizable": true, "fullscreen": false, "center": true, "focus": false, "visible": false, "transparent": true, "decorations": false, "shadow": false, "alwaysOnBottom": true, "visibleOnAllWorkspaces": true, "skipTaskbar": true }
    ],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Private, source-grounded local intelligence",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
